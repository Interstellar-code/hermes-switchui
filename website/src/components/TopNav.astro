---
import { SITE_VERSION } from '../site-version';
const docsHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/docs/welcome/`;

// Active link detection
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'SwitchUI', href: '/switchui' },
  { label: 'Hermes', href: '/hermes' },
  { label: 'Plugins', href: '/plugins' },
  { label: 'Docs', href: docsHref },
];
const isActive = (href) => {
  const cleanHref = href.replace(/\/$/, '') || '/';
  if (cleanHref === '/#cta') return false;
  if (cleanHref === '/') return path === '/';
  return path === cleanHref || path.startsWith(cleanHref + '/');
};
---

<!-- ── NAV ── -->
<nav class="topnav" id="topnav">
  <a href="/" class="topnav-brand">
    <img src="/logo-icon.png" alt="Hermes SwitchUI" style="height: 32px; width: auto;" />
    <span style="font-family: var(--m-font-mono); font-size: 13px; font-weight: 600; color: #fff; letter-spacing: 0.05em; margin-left: 10px; white-space: nowrap;">Hermes SwitchUI</span>
  </a>

  <div class="topnav-links" id="topnav-links">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`hl-navlink ${isActive(item.href) ? 'hl-navlink--active' : ''}`}
      >{item.label}</a>
    ))}
  </div>

  <div class="topnav-right">
    <!-- GitHub stars -->
    <a href="https://github.com/Interstellar-code/hermes-switchui" target="_blank" rel="noopener" class="gh-stars-btn" id="gh-stars-btn">
      <svg viewBox="0 0 16 16" fill="currentColor" width="13" height="13">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
      </svg>
      <span id="gh-stars-count">★ —</span>
    </a>
    <a href="https://github.com/Interstellar-code/hermes-switchui/releases" target="_blank" rel="noopener" class="nav-version" style="text-decoration: none;">v<span id="site-version-nav">{SITE_VERSION}</span></a>
    <a href="/#cta" class="m-btn m-btn-primary m-btn-sm">Install →</a>
  </div>

  <button class="topnav-hamburger" aria-label="Toggle menu" id="nav-hamburger">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>
</nav>

<script>
  // Hamburger toggle
  const hamburger = document.getElementById('nav-hamburger');
  const links = document.getElementById('topnav-links');
  if (hamburger && links) {
    hamburger.addEventListener('click', () => {
      links.classList.toggle('open');
    });
  }

  // Scroll shadow
  const nav = document.getElementById('topnav');
  if (nav) {
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 60);
    }, { passive: true });
  }

  // GitHub stars
  fetch('https://api.github.com/repos/Interstellar-code/hermes-switchui')
    .then(r => r.json())
    .then(d => {
      const el = document.getElementById('gh-stars-count');
      if (el && d.stargazers_count != null) {
        const n = d.stargazers_count;
        el.textContent = `★ ${n >= 1000 ? (n / 1000).toFixed(1) + 'k' : n}`;
      }
    })
    .catch(() => {});

  // GitHub latest release — dynamic version badge with sessionStorage caching
  (() => {
    const CACHE_KEY = 'hsui_latest_release';
    const CACHE_TTL = 10 * 60 * 1000; // 10 minutes

    function applyVersion(tag) {
      const nav = document.getElementById('site-version-nav');
      const hero = document.getElementById('site-version-hero');
      const footer = document.getElementById('site-version-footer');
      if (nav) nav.textContent = tag;
      if (hero) hero.textContent = tag;
      if (footer) footer.textContent = tag;
    }

    function fetchAndCache() {
      fetch('https://api.github.com/repos/Interstellar-code/hermes-switchui/releases/latest')
        .then(r => r.json())
        .then(d => {
          const tag = (d.tag_name || '').replace(/^v/, '');
          if (tag) {
            try {
              sessionStorage.setItem(CACHE_KEY, JSON.stringify({ tag, ts: Date.now() }));
            } catch (_) {}
            applyVersion(tag);
          }
        })
        .catch(() => {});
    }

    try {
      const raw = sessionStorage.getItem(CACHE_KEY);
      if (raw) {
        const cached = JSON.parse(raw);
        if (cached.tag && Date.now() - cached.ts < CACHE_TTL) {
          applyVersion(cached.tag);
          return;
        }
      }
    } catch (_) {}

    fetchAndCache();
  })();
</script>
