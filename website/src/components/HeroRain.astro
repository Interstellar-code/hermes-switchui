---
import { SITE_VERSION } from '../site-version';

export interface Props {
  eyebrow?: string;
  title?: string;
  accent?: string;
  subtitle?: string;
  showBoot?: boolean;
  showHint?: boolean;
}

const {
  eyebrow = 'HERMES SWITCHUI',
  title = 'WELCOME TO',
  accent = 'HERMES SWITCHUI',
  subtitle = 'A stunning Matrix-themed web interface for your local AI agent. Chat, manage files, run terminals, and orchestrate multiple agents — all from your browser, all on your own machine.',
  showBoot = true,
  showHint = true,
} = Astro.props;
---

<section class="hero-section m-scanlines" id="hero" data-boot={showBoot ? 'true' : 'false'}>
  <canvas id="rain-canvas" aria-hidden="true" role="presentation"></canvas>
  <div class="hero-overlay-radial"></div>
  <div class="hero-overlay-scan"></div>

  <div class="hero-inner">
    {showBoot && (
      <div class="boot-panel" id="boot-panel">
        <div id="boot-lines"></div>
        <div id="boot-cursor" class="m-cursor"></div>
      </div>
    )}

    <div class={`hero-headline ${showBoot ? '' : 'visible'}`} id="hero-headline" aria-live="polite">
      <div class="hero-eyebrow">
        <span class="eyebrow-line"></span>
        {eyebrow}
      </div>
      <h1 id="hero-h1">
        {title}<br/>
        <span class="accent" id="hero-accent">{accent}</span>
      </h1>
      <p class="hero-sub">{subtitle}</p>
      {showHint && (
        <div style="margin-bottom: 24px;">
          <span class="badge-pill" style="border-color: rgba(0, 255, 65, 0.4); color: #fff; background: rgba(0, 255, 65, 0.08); font-size: 11px;">
            New here? Start with <strong>Your first chat</strong> — it gets you sending prompts in five minutes.
          </span>
        </div>
      )}
      <div class="hero-badges">
        <a href="https://github.com/Interstellar-code/hermes-switchui" target="_blank" rel="noopener" class="badge-gh" id="hero-gh-badge">
          <svg viewBox="0 0 16 16" fill="currentColor" width="12" height="12">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          <span id="hero-stars">GitHub</span>
        </a>
        <span class="badge-pill">v<span id="site-version-hero">{SITE_VERSION}</span> stable</span>
        <span class="badge-pill">MIT license</span>
        <span class="badge-pill">Open source</span>
      </div>
      <div class="hero-actions">
        <a href="/#cta" class="m-btn m-btn-primary m-btn-lg">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 12 16-8-5 18-3-7-8-3z"/></svg>
          Install Hermes
        </a>
        <a href="https://github.com/Interstellar-code/hermes-switchui" target="_blank" rel="noopener" class="m-btn m-btn-lg">View on GitHub →</a>
      </div>
    </div>
  </div>
</section>

<script>
import { SITE_VERSION } from '../site-version';
(() => {
  const G = '#00ff41';
  const heroEl = document.getElementById('hero');
  const showBoot = heroEl?.dataset.boot === 'true';

  // ── 3D Volumetric Cinematic Matrix Rain ─────────────────────────
  const cv = document.getElementById('rain-canvas') as HTMLCanvasElement;
  if (cv) {
    const ctx = cv.getContext('2d')!;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const chars = 'アイウエオカキクケコサシスセソタチツテト0123456789ABCDEF<>/$#%&'.split('');
    let w: number, h: number, raf: number, running = true;

    interface Stream {
      x: number;
      y: number;
      speed: number;
      fontSize: number;
      opacity: number;
      trailLength: number;
      glow: boolean;
      chars: string[];
    }

    let streams: Stream[] = [];

    function initStreams() {
      streams = [];
      const density = Math.floor(w / 10);
      for (let i = 0; i < density; i++) {
        const depth = Math.random();
        const fontSize = Math.floor(8 + depth * 10);
        const speed = 0.4 + depth * 1.2;
        const opacity = 0.04 + depth * 0.16;
        const glow = depth > 0.6;
        const trailLength = Math.floor(10 + depth * 12);
        const streamChars: string[] = [];
        for (let j = 0; j < trailLength; j++) {
          streamChars.push(chars[Math.floor(Math.random() * chars.length)]);
        }
        streams.push({ x: Math.random() * w, y: Math.random() * h - h, speed, fontSize, opacity, trailLength, glow, chars: streamChars });
      }
    }

    function size() {
      const r = cv.parentElement!.getBoundingClientRect();
      w = r.width; h = r.height;
      cv.width = w * dpr; cv.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      initStreams();
    }

    function frame() {
      if (!running) return;
      ctx.fillStyle = 'rgba(2,8,4,0.12)';
      ctx.fillRect(0, 0, w, h);
      for (let i = 0; i < streams.length; i++) {
        const s = streams[i];
        for (let j = 0; j < s.trailLength; j++) {
          if (Math.random() < 0.03) s.chars[j] = chars[Math.floor(Math.random() * chars.length)];
        }
        ctx.font = `${s.fontSize}px 'JetBrains Mono', monospace`;
        for (let j = 0; j < s.trailLength; j++) {
          const charY = s.y - (j * s.fontSize);
          if (charY < 0 || charY > h) continue;
          const isHead = j === 0;
          const isSubHead = j === 1;
          const fraction = (s.trailLength - j) / s.trailLength;
          if (isHead) {
            ctx.fillStyle = `rgba(235, 255, 240, ${s.opacity * 2.5})`;
          } else if (isSubHead) {
            ctx.fillStyle = `rgba(0, 255, 65, ${s.opacity * 1.8})`;
          } else {
            ctx.fillStyle = `rgba(0, 180, 50, ${s.opacity * fraction})`;
          }
          ctx.fillText(s.chars[j], s.x, charY);
        }
        s.y += s.speed;
        if (s.y - (s.trailLength * s.fontSize) > h) {
          s.y = -s.fontSize;
          s.x = Math.random() * w;
          s.speed = 0.4 + Math.random() * 1.2;
        }
      }
      raf = requestAnimationFrame(frame);
    }

    size();
    const ro = new ResizeObserver(size);
    ro.observe(cv.parentElement!);
    const heroObs = new IntersectionObserver(([e]) => {
      running = e.isIntersecting;
      if (running) requestAnimationFrame(frame);
    }, { threshold: 0 });
    if (heroEl) heroObs.observe(heroEl);
    frame();
  }

  // ── Boot sequence (home page only) ──────────────────────────────
  if (showBoot) {
    const BOOT_SEQ = [
      { ms:  140, type:'cmd', text:'$ curl -fsSL https://.../hermes-switchui/install.sh | bash' },
      { ms:  500, type:'out', text:'  ↓  cloning hermes-switchui + resolving deps...' },
      { ms:  950, type:'bar', text:'install' },
      { ms: 1650, type:'ok',  text:'  dependencies installed via pnpm' },
      { ms: 1950, type:'ok',  text:`  hermes-switchui@${SITE_VERSION}  ready` },
      { ms: 2350, type:'gap', text:'' },
      { ms: 2550, type:'cmd', text:'$ hermes gateway run' },
      { ms: 2870, type:'ok',  text:'  ✓  Node.js 22.x detected' },
      { ms: 3180, type:'ok',  text:'  ✓  API key validated' },
      { ms: 3480, type:'out', text:'  >  Pulling agent profiles...' },
      { ms: 3850, type:'bar', text:'agents' },
      { ms: 4600, type:'ok',  text:'  ✓  neo · trinity · morpheus · oracle  loaded' },
      { ms: 4950, type:'ok',  text:'  ✓  Connected  ·  claude-sonnet-4  active' },
      { ms: 5350, type:'sys', text:'SYSTEM READY' },
      { ms: 5750, type:'ent', text:'> LAUNCHING SWITCHUI...' },
    ];

    const bootLines = document.getElementById('boot-lines');
    const bootCursor = document.getElementById('boot-cursor');
    const bootPanel = document.getElementById('boot-panel');
    const heroHeadline = document.getElementById('hero-headline');

    function addLine(type: string, text: string) {
      if (!bootLines) return;
      if (type === 'gap') { const g = document.createElement('div'); g.style.cssText = 'height:6px'; bootLines.appendChild(g); return; }
      if (type === 'bar') {
        const wrap = document.createElement('div'); wrap.className = 'boot-bar';
        const isAgents = text === 'agents';
        wrap.innerHTML = `<div class="boot-bar-track"><div class="boot-bar-fill ${isAgents ? 'boot-bar-fill--slow' : ''}"></div></div><span class="boot-bar-pct">100%</span>`;
        bootLines.appendChild(wrap); return;
      }
      const el = document.createElement('div'); el.className = 'boot-line boot-line--' + type; el.textContent = text;
      bootLines.appendChild(el); bootLines.scrollTop = bootLines.scrollHeight;
    }

    if (bootLines && bootPanel && heroHeadline) {
      BOOT_SEQ.forEach(({ ms, type, text }) => setTimeout(() => addLine(type, text), ms));
      setTimeout(() => {
        if (bootCursor) bootCursor.style.display = 'none';
        bootPanel.style.maxHeight = bootPanel.scrollHeight + 'px';
        requestAnimationFrame(() => {
          bootPanel.style.maxHeight = '0'; bootPanel.style.opacity = '0';
          bootPanel.style.paddingTop = '0'; bootPanel.style.paddingBottom = '0';
          bootPanel.style.marginBottom = '0'; bootPanel.style.minHeight = '0';
        });
      }, 6200);
      setTimeout(() => { heroHeadline.classList.add('visible'); }, 6400);
      setTimeout(() => { bootPanel.style.display = 'none'; }, 6900);
    }
  }

  // ── GitHub stars ───────────────────────────────────────────────
  fetch('https://api.github.com/repos/Interstellar-code/hermes-switchui')
    .then(r => r.json())
    .then(d => {
      const el = document.getElementById('hero-stars');
      if (el && d.stargazers_count != null) {
        const n = d.stargazers_count;
        el.textContent = `★ ${n >= 1000 ? (n/1000).toFixed(1)+'k' : n} on GitHub`;
      }
    })
    .catch(() => {});

  // ── Version badge ──────────────────────────────────────────────
  (() => {
    const CACHE_KEY = 'hsui_latest_release';
    const CACHE_TTL = 10 * 60 * 1000;
    function applyVersion(tag) {
      const nav = document.getElementById('site-version-nav');
      const hero = document.getElementById('site-version-hero');
      const footer = document.getElementById('site-version-footer');
      if (nav) nav.textContent = tag;
      if (hero) hero.textContent = tag;
      if (footer) footer.textContent = tag;
    }
    function fetchAndCache() {
      fetch('https://api.github.com/repos/Interstellar-code/hermes-switchui/releases/latest')
        .then(r => r.json())
        .then(d => { const tag = (d.tag_name || '').replace(/^v/, ''); if (tag) { try { sessionStorage.setItem(CACHE_KEY, JSON.stringify({ tag, ts: Date.now() })); } catch (_) {} applyVersion(tag); } })
        .catch(() => {});
    }
    try {
      const raw = sessionStorage.getItem(CACHE_KEY);
      if (raw) { const cached = JSON.parse(raw); if (cached.tag && Date.now() - cached.ts < CACHE_TTL) { applyVersion(cached.tag); return; } }
    } catch (_) {}
    fetchAndCache();
  })();
})();
</script>
