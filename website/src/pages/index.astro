---
import LandingLayout from '../layouts/LandingLayout.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import HeroRain from '../components/HeroRain.astro';
---

<LandingLayout title="Hermes SwitchUI — Your Agents. One Interface.">
  <TopNav />
  <HeroRain />

  <!-- ─── WHAT IS IT ──────────────────────────────────────────── -->
  <div class="glow-divider" aria-hidden="true"></div>
  <section class="hl-section" id="what-is-it">
    <div class="hl-section-head hl-section-head--center">
      <div class="hl-section-label hl-section-label--center">
        <span class="hl-label-line"></span>
        WHAT IS HERMES SWITCHUI
        <span class="hl-label-line"></span>
      </div>
      <h2 class="hl-section-h2 hl-section-h2--center">Two pieces. One seamless experience.</h2>
      <p class="hl-carousel-sub" style="max-width: 720px; margin: 12px auto 0;">
        Hermes SwitchUI is a beautiful, Matrix-themed web interface for the Hermes Agent — a powerful local AI runtime that ships with 8 custom plugins. You open it in your browser. It talks to the agent running on your machine. No cloud, no subscriptions, full control.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-top: 32px;">
      <a href="/switchui" class="hl-feat-card reveal visible" style="text-decoration: none; color: inherit;">
        <div class="hl-feat-card-top">
          <div class="hl-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="18" height="18"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          </div>
          <span class="hl-feat-num" style="color: var(--m-green-500); font-family: var(--m-font-mono);">Interface</span>
        </div>
        <h3 class="hl-feat-name">SwitchUI</h3>
        <p class="hl-feat-desc" style="margin-bottom: 0;">
          The web app you open in your browser. Chat with AI, browse files, run terminals, manage agents — all wrapped in a stunning Matrix-inspired theme.
        </p>
      </a>

      <a href="/hermes" class="hl-feat-card reveal visible" style="text-decoration: none; color: inherit;">
        <div class="hl-feat-card-top">
          <div class="hl-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="18" height="18"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
          </div>
          <span class="hl-feat-num" style="color: var(--m-green-500); font-family: var(--m-font-mono);">Engine</span>
        </div>
        <h3 class="hl-feat-name">Hermes Agent</h3>
        <p class="hl-feat-desc" style="margin-bottom: 0;">
          The powerful AI engine running in the background. Handles providers, remembers conversations, manages tools, and ships with 8 custom plugins out of the box.
        </p>
      </a>
    </div>
  </section>

  <!-- ─── EXPLORE ─────────────────────────────────────────────── -->
  <div class="glow-divider" aria-hidden="true"></div>
  <section class="hl-section" id="explore">
    <div class="hl-section-head hl-section-head--center">
      <div class="hl-section-label hl-section-label--center">
        <span class="hl-label-line"></span>
        EXPLORE
        <span class="hl-label-line"></span>
      </div>
      <h2 class="hl-section-h2 hl-section-h2--center">Dive deeper into each layer.</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
      <a href="/switchui" class="hl-feat-card reveal" style="text-decoration: none; color: inherit;">
        <div class="hl-feat-card-top">
          <div class="hl-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="18" height="18"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 17V9M15 17v-5M3 9h18"/></svg>
          </div>
          <span class="hl-feat-num">→</span>
        </div>
        <h3 class="hl-feat-name">SwitchUI</h3>
        <p class="hl-feat-desc">See every feature the interface offers — chat, files, terminal, dashboard, boards, workflows, Matrix3D, and 10+ more capabilities that light up automatically.</p>
      </a>

      <a href="/hermes" class="hl-feat-card reveal" style="text-decoration: none; color: inherit;">
        <div class="hl-feat-card-top">
          <div class="hl-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="18" height="18"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <span class="hl-feat-num">→</span>
        </div>
        <h3 class="hl-feat-name">Hermes Agent</h3>
        <p class="hl-feat-desc">Understand the engine — how it routes AI providers, manages memory, probes capabilities, and stays extensible through plugins, MCP servers, and skills.</p>
      </a>

      <a href="/plugins" class="hl-feat-card reveal" style="text-decoration: none; color: inherit;">
        <div class="hl-feat-card-top">
          <div class="hl-feat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="18" height="18"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          </div>
          <span class="hl-feat-num">→</span>
        </div>
        <h3 class="hl-feat-name">Plugins</h3>
        <p class="hl-feat-desc">Meet the 8 custom plugins that supercharge the agent — workflow engine, kanban boards, agent-to-agent fleet, lazy MCP, self-improvement, and more.</p>
      </a>
    </div>
  </section>

  <!-- ─── GET STARTED ─────────────────────────────────────────── -->
  <div class="glow-divider" aria-hidden="true"></div>
  <section class="hl-install-section" id="cta">
    <div class="hl-install-inner">
      <div class="hl-section-label hl-section-label--center">GET STARTED</div>
      <h2 class="hl-install-heading">
        Deploy in <span class="hl-glow-text">minutes.</span>
      </h2>
      <p class="hl-install-sub">Open source. Self-hosted. No lock-in.</p>
      <div class="hl-install-cmd">
        <span class="hl-cmd-dollar">$</span>
        <span class="hl-cmd-text">curl -fsSL https://raw.githubusercontent.com/Interstellar-code/hermes-switchui/main/install.sh | bash</span>
      </div>
      <div class="hl-install-actions">
        <a href="https://github.com/Interstellar-code/hermes-switchui#-quick-start" target="_blank" rel="noopener" class="m-btn m-btn-primary m-btn-lg">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 12 16-8-5 18-3-7-8-3z"/></svg>
          Quick Start
        </a>
        <a href="https://github.com/Interstellar-code/hermes-switchui" target="_blank" rel="noopener" class="m-btn m-btn-lg">GitHub →</a>
        <a href="/docs/welcome" class="m-btn m-btn-lg">Docs Portal →</a>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    (() => {
      const els = document.querySelectorAll('.reveal');
      if (!els.length) return;
      const observer = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } }),
        { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
      );
      els.forEach(el => observer.observe(el));
    })();
  </script>
</LandingLayout>
