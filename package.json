{
  "name": "hermes-switchui",
  "version": "2.5.19",
  "description": "Hermes SwitchUI — Interstellar Code's opinionated workspace for Hermes Agent",
  "author": "Interstellar Code (https://github.com/Interstellar-code)",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "rm -f src/routeTree.gen.ts && NODE_OPTIONS=\"--max-old-space-size=2048\" vite dev",
    "build:website": "if [ -d website ]; then PUBLIC_SITE_VERSION=$(node -p \"require('./package.json').version\") && cd website && npm install && SITE_BASE=/website PUBLIC_SITE_VERSION=$PUBLIC_SITE_VERSION npm run build; else echo 'website/ not present (excluded from Docker context) — skipping marketing site build'; fi",
    "build": "pnpm build:website && HERMES_SKIP_GATEWAY_BOOT=1 vite build",
    "prestart:all": "node scripts/check-ports.mjs",
    "start:all": "concurrently --kill-others \"hermes gateway run\" \"hermes dashboard --no-open --skip-build\" \"pnpm dev\"",
    "start": "NODE_OPTIONS=\"--max-old-space-size=2048\" node .output/server/index.mjs",
    "start:dev": "rm -f src/routeTree.gen.ts && NODE_OPTIONS=\"--max-old-space-size=2048\" vite dev",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:capture-tools": "node scripts/capture-tool-tab.mjs",
    "smoke:managed": "node scripts/managed-companion-smoke.mjs",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "pnpm build && pnpm electron:bundle-server && electron-builder --config electron-builder.config.cjs",
    "electron:build:mac": "pnpm build && pnpm electron:bundle-server && electron-builder --mac --config electron-builder.config.cjs",
    "electron:build:win": "pnpm build && pnpm electron:bundle-server && electron-builder --win --config electron-builder.config.cjs",
    "electron:bundle-server": "esbuild dist/server/server.js --bundle --platform=node --format=cjs --outfile=electron/server-bundle.cjs",
    "seed-personas": "tsx scripts/seed-personas.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@hono/zod-openapi": "^1.4.0",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.4",
    "@lobehub/icons": "^5.10.0",
    "@lobehub/icons-static-png": "^1.91.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.11",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.20",
    "@tanstack/react-virtual": "^3.14.3",
    "@tanstack/router-plugin": "^1.168.14",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "ecctrl": "^1.0.97",
    "electron-updater": "^6.6.2",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.23",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "monaco-editor": "0.55.1",
    "motion": "^12.40.0",
    "motion-dom": "^12.40.0",
    "motion-utils": "^12.39.0",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "postprocessing": "^6.39.1",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-joyride": "^3.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "0.182.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.60.0",
    "@tanstack/eslint-config": "^0.4.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.6",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "react-grab": "^0.1.44",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^4.1.8",
    "web-vitals": "^5.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion@1": "1.1.15",
      "brace-expansion@2": "2.1.1",
      "brace-expansion@5": "5.0.6",
      "tmp": "^0.2.6",
      "dompurify": "^3.4.7"
    }
  }
}
