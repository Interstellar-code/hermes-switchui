---
export interface Props {
  icon: string;
  title: string;
  description: string;
  tag?: string;
  featured?: boolean;
}
const { icon, title, description, tag, featured = false } = Astro.props;
---
<div class:list={['feature-card', 'reveal', { 'feature-card--featured': featured }]}>
  <div class="feature-icon">
    <Fragment set:html={icon} />
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  {tag && <span class="feature-tag"><span class="m-badge m-badge-ghost">{tag}</span></span>}
</div>
