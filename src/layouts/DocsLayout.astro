---
import '../styles/landing.css';
import '../styles/docs.css';

export interface Props {
  title: string;
  description?: string;
  activeKey?: string;
}

const {
  title,
  description = 'Hermes Switch UI Documentation Portal',
  activeKey = 'welcome',
} = Astro.props;

const canonical = Astro.url.href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#020804" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="canonical" href={canonical} />
  <title>{title} | Hermes Switch UI Docs</title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="docs-body">
  <a href="#main-docs-content" class="skip-link">Skip to content</a>

  <!-- ── TICKER ── -->
  <div class="hl-ticker-wrap" aria-hidden="true">
    <div class="hl-ticker">
      {Array.from({length: 4}).map(() => (
        <span class="hl-ticker-text">■&nbsp;&nbsp;SYS_STATUS: ONLINE&nbsp;&nbsp;·&nbsp;&nbsp;GATEWAY: PORT 8642&nbsp;&nbsp;·&nbsp;&nbsp;SECURITY: ENCRYPTED&nbsp;&nbsp;·&nbsp;&nbsp;DOCUMENTATION SYSTEM v1.0&nbsp;&nbsp;·&nbsp;&nbsp;</span>
      ))}
    </div>
  </div>

  <!-- ── NAVIGATION HEADER ── -->
  <header class="docs-header">
    <nav class="topnav">
      <a href="/" class="topnav-brand">
        <div class="glyph">ᕼ</div>
        <div class="brand-text">
          <div class="brand-name">HERMES</div>
          <div class="brand-sub">DOCS PORTAL</div>
        </div>
      </a>

      <div class="topnav-links">
        <a href="/" class="hl-navlink">← Back to Home</a>
        <a href="/docs/welcome" class="hl-navlink" style="color: var(--d-green);">Welcome</a>
      </div>

      <div class="topnav-right">
        <a href="https://github.com/nousresearch/hermes-agent" target="_blank" rel="noopener" class="gh-stars-btn">
          <svg viewBox="0 0 16 16" fill="currentColor" width="13" height="13">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          <span>GitHub</span>
        </a>
        <span class="nav-access">ACCESS: GRANTED</span>
      </div>
    </nav>
  </header>

  <!-- Mobile Nav Toggler -->
  <div class="docs-mobile-nav-bar">
    <span style="font-family: var(--d-font-mono); font-size: 11px; color: var(--d-green)">SYS::INDEX</span>
    <button class="docs-mobile-toggle" id="sidebar-toggle-btn">Toggle Index</button>
  </div>

  <!-- ── MAIN WRAPPER ── -->
  <div class="docs-layout-container">
    
    <!-- LEFT SIDEBAR -->
    <aside class="docs-sidebar-left" id="docs-sidebar-left">
      <div class="docs-nav-group">
        <div class="docs-nav-title">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 19.5A2.5 2.5 0 0 0 6.5 22H20M4 19.5V3.5A2.5 2.5 0 0 1 6.5 1H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5z"/></svg>
          Getting Started
        </div>
        <ul class="docs-nav-list">
          <li>
            <a href="/docs/welcome" class={`docs-nav-link ${activeKey === 'welcome' ? 'active' : ''}`}>
              Welcome
              <span class="docs-nav-badge">Core</span>
            </a>
          </li>
          <li>
            <a href="#" class="docs-nav-link">
              Your first chat
              <span class="docs-nav-badge" style="border-color: rgba(95,207,255,0.4); color: #5fcfff; background: rgba(95,207,255,0.06)">5m</span>
            </a>
          </li>
          <li>
            <a href="#" class="docs-nav-link">Architecture</a>
          </li>
        </ul>
      </div>

      <div class="docs-nav-group">
        <div class="docs-nav-title">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
          Core App
        </div>
        <ul class="docs-nav-list">
          <li><a href="#" class="docs-nav-link">Chat & Streams</a></li>
          <li><a href="#" class="docs-nav-link">Sessions Manager</a></li>
          <li><a href="#" class="docs-nav-link">File Explorer</a></li>
          <li><a href="#" class="docs-nav-link">Terminal (PTY)</a></li>
          <li><a href="#" class="docs-nav-link">Dashboard Status</a></li>
        </ul>
      </div>

      <div class="docs-nav-group">
        <div class="docs-nav-title">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          Extended Capabilities
        </div>
        <ul class="docs-nav-list">
          <li><a href="#" class="docs-nav-link">Kanban Boards</a></li>
          <li><a href="#" class="docs-nav-link">Graph Workflows</a></li>
          <li><a href="#" class="docs-nav-link">Matrix3D View</a></li>
          <li><a href="#" class="docs-nav-link">Skills Editor</a></li>
          <li><a href="#" class="docs-nav-link">MCP Server Hub</a></li>
          <li><a href="#" class="docs-nav-link">Memory & Agora</a></li>
        </ul>
      </div>
    </aside>

    <!-- CENTER CONTENT -->
    <main class="docs-main-content" id="main-docs-content">
      <div class="docs-breadcrumb">
        Docs <span class="docs-breadcrumb-separator">/</span> Getting Started <span class="docs-breadcrumb-separator">/</span> Welcome
      </div>
      <div class="docs-content">
        <slot />
      </div>
    </main>

    <!-- RIGHT SIDEBAR (TOC) -->
    <aside class="docs-sidebar-right">
      <div class="docs-toc-title">On this page</div>
      <ul class="docs-toc-list">
        <li><a href="#welcome" class="docs-toc-link">Welcome</a></li>
        <li><a href="#what-is-hermes-switch-ui" class="docs-toc-link">What is Hermes Switch UI</a></li>
        <li><a href="#architecture-at-a-glance" class="docs-toc-link">Architecture at a glance</a></li>
        <li><a href="#what-happens-when-you-send-a-message" class="docs-toc-link">What happens when you send a message</a></li>
        <li><a href="#what-you-can-do" class="docs-toc-link">What you can do</a></li>
        <li><a href="#how-its-structured" class="docs-toc-link">How it's structured</a></li>
      </ul>
    </aside>

  </div>

  <script>
    // Responsive sidebar toggle
    const toggleBtn = document.getElementById('sidebar-toggle-btn');
    const sidebar = document.getElementById('docs-sidebar-left');
    if (toggleBtn && sidebar) {
      toggleBtn.addEventListener('click', (e) => {
        sidebar.classList.toggle('open');
        toggleBtn.textContent = sidebar.classList.contains('open') ? 'Close Index' : 'Toggle Index';
        e.stopPropagation();
      });
      document.addEventListener('click', (e) => {
        if (sidebar.classList.contains('open') && !sidebar.contains(e.target as Node) && e.target !== toggleBtn) {
          sidebar.classList.remove('open');
          toggleBtn.textContent = 'Toggle Index';
        }
      });
    }
  </script>
</body>
</html>
